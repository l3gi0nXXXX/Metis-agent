        }
    }

    @TestCase
    public func telegramImageDownloadTooLargeFallbackKeepsDownloadLimitSeparate(): Unit {
        let sentTexts = ArrayList<String>()
        let mediaContext = gatewaySessionTurnImageMediaContext(
            "",
