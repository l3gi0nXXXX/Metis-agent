private func gatewaySessionTurnTtsTestHome(label: String): String {
    "/tmp/metis-gateway-session-turn-tts-${label}-${DateTime.now().toUnixTimeStamp().toMilliseconds()}"
}

private func gatewaySessionTurnInstallTtsConfig(home: String): Unit {
    let root = JsonObject()
    let gateway = JsonObject()
    let speech = JsonObject()
    let tts = JsonObject()
    tts.put("provider", JsonString("fake-command"))
    let providers = JsonObject()
    let provider = JsonObject()
    provider.put("kind", JsonString("command"))
    provider.put("outputExtension", JsonString("ogg"))
    provider.put("command", JsonArray([
        JsonString("sh"),
        JsonString("-c"),
        JsonString("printf 'session-turn-tts' > \"$2\""),
        JsonString("metis-tts"),
        JsonString("{text}"),
        JsonString("{output}")
    ]))
    providers.put("fake-command", provider)
    tts.put("providers", providers)
    speech.put("tts", tts)
    gateway.put("speech", speech)
    let telegram = JsonObject()
    let telegramSpeech = JsonObject()
    telegramSpeech.put("audioAsVoice", JsonBool(true))
    telegramSpeech.put("autoReplyToVoice", JsonBool(true))
    telegram.put("speech", telegramSpeech)
    gateway.put("telegram", telegram)
    root.put("gateway", gateway)
    MetisConfigManager.writeRoot(root)
    CliSettingManager.invalidate()
    Directory.create(Path(home).join("gateway-tts"), recursive: true)
}

private func gatewaySessionTurnResetEnv(oldHome: Option<String>, home: String): Unit {
    match (oldHome) {
        case Some(value) => setVariable("METIS_HOME", value)
        case None => setVariable("METIS_HOME", "")
    }
    MetisConfigManager.invalidate()
    CliSettingManager.invalidate()
    CliConfig.invalidatePathCache()
    try { remove(Path(home), recursive: true) } catch (_e: Exception) { () }
}

private func gatewaySessionTurnWriteAgentRuntimeConfig(home: Path): Unit {
    let root = JsonObject()
    let agents = JsonObject()
    let defaults = JsonObject()
    defaults.put("workspace", JsonString(home.join("workspaces").toString()))
    agents.put("defaults", defaults)
    let list = JsonArray([])
    let writer = JsonObject()
    writer.put("id", JsonString("writer"))
    writer.put("workspace", JsonString(home.join("workspaces").join("writer").toString()))
    writer.put("agentDir", JsonString(home.join("agents").join("writer").join("agent").toString()))
    let model = JsonObject()
    model.put("primary", JsonString("openai:gpt-4o-mini"))
    writer.put("model", model)
    list.add(writer)
    agents.put("list", list)
    root.put("agents", agents)
    File.writeTo(MetisConfigManager.configPath(), root.toJsonString().toArray())
    CliConfig.invalidatePathCache()
    MetisConfigManager.invalidate()
    CliSettingManager.invalidate()
}

private func gatewaySessionTurnImageMediaContext(
    localPath: String,
    status!: String = "",
    error!: String = ""
): JsonObject {
    let media = JsonObject()
    let records = JsonArray([])
    let record = JsonObject()
    record.put("mediaId", JsonString("tg-image-fallback"))
    record.put("mediaKind", JsonString("photo"))
    record.put("mimeType", JsonString("image/jpeg"))
    record.put("localPath", JsonString(localPath))
    record.put("downloaded", JsonBool(true))
    record.put("channel", JsonString("telegram"))
    if (!status.trimAscii().isEmpty()) {
        record.put("mediaUnderstandingStatus", JsonString(status.trimAscii()))
        record.put("mediaUnderstandingCapability", JsonString("image"))
    }
    if (!error.trimAscii().isEmpty()) {
        record.put("mediaUnderstandingError", JsonString(error.trimAscii()))
    }
    records.add(record)
    media.put("records", records)
    media
}

private func gatewaySessionTurnFeishuMetadataOnlyDocumentContext(): JsonObject {
    let media = JsonObject()
    media.put("channel", JsonString("feishu"))
    media.put("accountId", JsonString("default"))
    let records = JsonArray([])
    let record = JsonObject()
    record.put("mediaId", JsonString("default:oc_1:om_1:file:file_1"))
    record.put("channel", JsonString("feishu"))
    record.put("accountId", JsonString("default"))
    record.put("peerId", JsonString("oc_1"))
    record.put("messageId", JsonString("om_1"))
    record.put("mediaKind", JsonString("document"))
    record.put("mimeType", JsonString("application/octet-stream"))
    record.put("fileName", JsonString("archive.bin"))
    record.put("downloaded", JsonBool(false))
    record.put("skippedReason", JsonString("metadata_only"))
    record.put("mediaUnderstandingStatus", JsonString("metadata_only"))
    record.put("mediaUnderstandingCapability", JsonString("document"))
    records.add(record)
    media.put("records", records)
    media
}

private func gatewaySessionTurnGuardContext(channelName: String): GatewaySessionContext {
    GatewaySessionContext(
        GatewayIngressSource.Channel(channelName),
        channelName,
        channelName,
        "${channelName}:chat:guard",
        "general",
        deliveryTarget: Some(GatewayDeliveryTarget(channelName, "peer-1", accountId: "default", replyToMessageId: "msg-1"))
    )
}

private func gatewaySessionTurnRepeatText(text: String, count: Int64): String {
    let out = StringBuilder()
    for (_ in 0..count) {
        out.append(text)
    }
    out.toString()
}

@Test
public class GatewaySessionTurnRunnerTest {
    @TestCase
    public func telegramSystemPromptTellsModelToUseTtsToolForVoiceReply(): Unit {
        let prompt = gatewayPolicyFilteredSystemPrompt(channelName: "telegram", modelName: "test-model")
        @Expect(prompt.contains("do not use `shellExecute`"), true)
        @Expect(prompt.contains("Call the `tts` tool"), true)
        @Expect(prompt.contains("<silent_reply>"), true)
        @Expect(prompt.contains("Write the exact text that should be spoken as the final answer; the Telegram Gateway will synthesize and deliver"), false)
    }

    @TestCase
    public func feishuMetadataOnlyMediaPromptDoesNotSuggestMissingAppCredentials(): Unit {
        let prompt = gatewayBuildMediaContextPromptForUser(
            gatewaySessionTurnFeishuMetadataOnlyDocumentContext(),
            GatewayUserSettings()
        )
        @Expect(prompt.contains("MediaUnderstandingStatus=metadata_only"), true)
        @Expect(prompt.contains("skippedReason=metadata_only"), true)
        @Expect(prompt.contains("missing_app_credentials"), false)
        @Expect(prompt.contains("configure_feishu_app_credentials"), false)
        @Expect(prompt.contains("app credentials"), false)
        @Expect(prompt.contains("missing appId/appSecret"), false)
    }

    @TestCase
    public func sessionRequestTurnPushesEffectiveAgentRuntimeIntoToolContext(): Unit {
        synchronized(MetisProcessEnvironmentLock) {
            let home = Path(gatewaySessionTurnTtsTestHome("phase4-tool-context"))
            let oldHome = getVariable("METIS_HOME")
            try { remove(home, recursive: true) } catch (_e: Exception) { () }
            Directory.create(home, recursive: true)
            setVariable("METIS_HOME", home.toString())
            CliConfig.invalidatePathCache()
            MetisConfigManager.invalidate()
            CliSettingManager.invalidate()
            gatewaySessionTurnWriteAgentRuntimeConfig(home)

            let captured = ArrayList<String>()
            setGatewayAgentBridgeReplyRunnerForTest(Some({
                _conversationKey: String,
                _prompt: String,
                _channelName: String,
                _agentId: String,
                _streamingEnabled: Bool,
                _streamChunkHook: Option<(String) -> Unit> =>
                    match (gatewayCurrentToolRuntimeContext()) {
                        case Some(ctx) =>
                            captured.add(ctx.agentId)
                            captured.add(ctx.workspaceDir)
                            captured.add(ctx.agentDir)
                            captured.add(ctx.modelsJsonPath)
                            captured.add(ctx.authProfilesPath)
                        case None => captured.add("missing-context")
                    }
                    "tool context ok"
            }))
            try {
                let user = CliSettingManager.readGatewaySettings()
                let request = GatewaySessionRequest(
                    GatewayIngressSource.DashboardRpc,
                    sessionHint: "main",
                    agentId: "writer",
                    text: "hello"
                )
                let result = gatewayExecuteSessionRequestTurnForUser(
                    user,
                    request,
                    "hello"
                )
                @Expect(result.context.turnContext.agentId, "writer")
                @Expect(result.context.turnContext.workspaceDir, home.join("workspaces").join("writer").toString())
                @Expect(captured.size, 5)
                @Expect(captured[0], "writer")
                @Expect(captured[1], home.join("workspaces").join("writer").toString())
                @Expect(captured[2], home.join("agents").join("writer").join("agent").toString())
                @Expect(captured[3], home.join("agents").join("writer").join("agent").join("models.json").toString())
                @Expect(captured[4], home.join("agents").join("writer").join("agent").join("auth-profiles.json").toString())
            } finally {
                setGatewayAgentBridgeReplyRunnerForTest(None<(String, String, String, String, Bool, Option<(String) -> Unit>) -> String>)
                match (oldHome) {
                    case Some(value) => setVariable("METIS_HOME", value)
                    case None => setVariable("METIS_HOME", "")
                }
                CliConfig.invalidatePathCache()
                MetisConfigManager.invalidate()
                CliSettingManager.invalidate()
                try { remove(home, recursive: true) } catch (_e: Exception) { () }
            }
        }
    }

    @TestCase
    public func sessionRequestTurnPushesCronToolExecPolicyIntoToolContext(): Unit {
        synchronized(MetisProcessEnvironmentLock) {
            let home = Path(gatewaySessionTurnTtsTestHome("cron-tool-policy"))
            let oldHome = getVariable("METIS_HOME")
            try { remove(home, recursive: true) } catch (_e: Exception) { () }
            Directory.create(home, recursive: true)
            setVariable("METIS_HOME", home.toString())
            CliConfig.invalidatePathCache()
            MetisConfigManager.invalidate()
            CliSettingManager.invalidate()

            let captured = ArrayList<String>()
            setGatewayAgentBridgeReplyRunnerForTest(Some({
                _conversationKey: String,
                _prompt: String,
                _channelName: String,
                _agentId: String,
                _streamingEnabled: Bool,
                _streamChunkHook: Option<(String) -> Unit> =>
                    match (gatewayCurrentToolRuntimeContext()) {
                        case Some(ctx) =>
                            captured.add(ctx.sourceLabel)
                            captured.add(ctx.cronJobId)
                            captured.add(ctx.toolExecMode)
                            captured.add("${ctx.toolExecAllowlist.size}")
                            if (ctx.toolExecAllowlist.size > 0) {
                                captured.add(ctx.toolExecAllowlist[0])
                            }
                        case None => captured.add("missing-context")
                    }
                    "cron tool policy ok"
            }))
            try {
                let user = CliSettingManager.readGatewaySettings()
                let request = GatewaySessionRequest(
                    GatewayIngressSource.Cron,
                    sessionHint: "gateway:cron:isolated:job-a",
                    agentId: "general",
                    text: "hello",
                    cronJobId: "job-a",
                    toolExecMode: "ALLOWLIST",
                    toolExecAllowlist: ["curl", "curl"]
                )
                let result = gatewayExecuteSessionRequestTurnForUser(user, request, "hello")
                @Expect(result.context.sourceLabel, "cron")
                @Expect(captured.size, 5)
                @Expect(captured[0], "cron")
                @Expect(captured[1], "job-a")
                @Expect(captured[2], "allowlist")
                @Expect(captured[3], "1")
                @Expect(captured[4], "curl")
            } finally {
                setGatewayAgentBridgeReplyRunnerForTest(None<(String, String, String, String, Bool, Option<(String) -> Unit>) -> String>)
                match (oldHome) {
                    case Some(value) => setVariable("METIS_HOME", value)
                    case None => setVariable("METIS_HOME", "")
                }
                CliConfig.invalidatePathCache()
                MetisConfigManager.invalidate()
                CliSettingManager.invalidate()
                try { remove(home, recursive: true) } catch (_e: Exception) { () }
            }
        }
    }

    @TestCase
    public func feishuMessageToolDeliveryDuringSessionRequestUsesCurrentGatewayHook(): Unit {
        let sentChannels = ArrayList<String>()
        let sentPeers = ArrayList<String>()
        let sentTexts = ArrayList<String>()
        setGatewayAgentBridgeReplyRunnerForTest(Some({
            _conversationKey: String,
            _prompt: String,
            _channelName: String,
            _agentId: String,
            _streamingEnabled: Bool,
            _streamChunkHook: Option<(String) -> Unit> =>
                let _ = GatewayMessageToolset().debugMessageForTest("photo", "feishu", "ou_1", "/tmp/pic.png")
                "<SILENT_REPLY>"
        }))
        try {
            let store = GatewaySessionStore(Path("."), enabled: false, agentId: "general")
            let bridge = AgentBridge(sessionStore: store)
            let request = GatewaySessionRequest(
                GatewayIngressSource.Channel("feishu"),
                channelName: "feishu",
                sessionHint: "feishu:direct:ou_1",
                agentId: "general",
                text: "把这张图片发给我",
                accountId: "default",
                peerId: "ou_1",
                senderId: "ou_1",
                deliver: true
            )
            let result = gatewayExecuteSessionRequestTurn(
                bridge,
                request,
                "把这张图片发给我",
                deliver: true,
                deliverHook: Some({
                    channelName: String,
                    _accountId: String,
                    peerId: String,
                    text: String,
                    _replyToMessageId: Option<String>,
                    _replyInThread: Bool =>
                        sentChannels.add(channelName)
                        sentPeers.add(peerId)
                        sentTexts.add(text)
                        "tool-${sentTexts.size}"
                })
            )
            @Expect(result.execution.delivered, true)
            @Expect(result.execution.deliveryStatus, "delivered-by-tool")
            @Expect(sentChannels.size, 1)
            @Expect(sentChannels[0], "feishu")
            @Expect(sentPeers[0], "ou_1")
            @Expect(sentTexts[0].startsWith("[photo]"), true)
        } finally {
            setGatewayAgentBridgeReplyRunnerForTest(None<(String, String, String, String, Bool, Option<(String) -> Unit>) -> String>)
        }
    }

    @TestCase
    public func feishuFinalDeliveryUnwrapsTerminalToolEnvelope(): Unit {
        let sentTexts = ArrayList<String>()
        setGatewayAgentBridgeReplyRunnerForTest(Some({
            _conversationKey: String,
            _prompt: String,
            _channelName: String,
            _agentId: String,
            _streamingEnabled: Bool,
            _streamChunkHook: Option<(String) -> Unit> =>
                "{\"name\":\"answer\",\"arguments\":{\"result\":\"当前状态已获取成功\"}}"
        }))
        try {
            let store = GatewaySessionStore(Path("."), enabled: false, agentId: "general")
            let bridge = AgentBridge(sessionStore: store)
            let result = gatewayExecuteSessionTurn(
                bridge,
                gatewaySessionTurnGuardContext("feishu"),
                "status",
                deliver: true,
                deliverHook: Some({
                    _channelName: String,
                    _accountId: String,
                    _peerId: String,
                    text: String,
                    _replyToMessageId: Option<String>,
                    _replyInThread: Bool =>
                        sentTexts.add(text)
                        "m-${sentTexts.size}"
                })
            )

            @Expect(result.delivered, true)
            @Expect(sentTexts.size, 1)
            @Expect(sentTexts[0], "当前状态已获取成功")
            @Expect(sentTexts[0].contains("\"name\""), false)
            @Expect(sentTexts[0].contains("\"arguments\""), false)
        } finally {
            setGatewayAgentBridgeReplyRunnerForTest(None<(String, String, String, String, Bool, Option<(String) -> Unit>) -> String>)
        }
    }

    @TestCase
    public func feishuStreamingToolProtocolPrefixIsNotDelivered(): Unit {
        let sentTexts = ArrayList<String>()
        let runtimeContext = GatewayToolRuntimeContext("feishu", channelName: "feishu", sessionKey: "feishu:chat:guard")
        setGatewayAgentBridgeReplyRunnerForTest(Some({
            _conversationKey: String,
            _prompt: String,
            _channelName: String,
            _agentId: String,
            _streamingEnabled: Bool,
            streamChunkHook: Option<(String) -> Unit> =>
                match (streamChunkHook) {
                    case Some(notify) => notify("{\"name\":\"session_status\"")
                    case None => ()
                }
                gatewayMarkCurrentToolRuntimeVisibleReplyDelivered()
                "<SILENT_REPLY>"
        }))
        try {
            let store = GatewaySessionStore(Path("."), enabled: false, agentId: "general")
            let bridge = AgentBridge(sessionStore: store)
            let result = gatewayExecuteSessionTurn(
                bridge,
                gatewaySessionTurnGuardContext("feishu"),
                "status",
                deliver: true,
                streamingEnabled: true,
                toolRuntimeContext: Some(runtimeContext),
                deliverHook: Some({
                    _channelName: String,
                    _accountId: String,
                    _peerId: String,
                    text: String,
                    _replyToMessageId: Option<String>,
                    _replyInThread: Bool =>
                        sentTexts.add(text)
                        "m-${sentTexts.size}"
                })
            )

            @Expect(result.delivered, true)
            @Expect(result.deliveryStatus, "delivered-by-tool")
            @Expect(sentTexts.size, 0)
        } finally {
            setGatewayAgentBridgeReplyRunnerForTest(None<(String, String, String, String, Bool, Option<(String) -> Unit>) -> String>)
        }
    }

    @TestCase
    public func telegramStreamingPartialSuppressesFunctionsAnswerMarker(): Unit {
        let sentTexts = ArrayList<String>()
        let finalText = "正常中文 final🙂"
        setGatewayAgentBridgeReplyRunnerForTest(Some({
            _conversationKey: String,
            _prompt: String,
            _channelName: String,
            _agentId: String,
            _streamingEnabled: Bool,
            streamChunkHook: Option<(String) -> Unit> =>
                match (streamChunkHook) {
                    case Some(notify) =>
                        notify("fun")
                        notify("functions._answer_")
                    case None => ()
                }
                finalText
        }))
        try {
            let store = GatewaySessionStore(Path("."), enabled: false, agentId: "general")
            let bridge = AgentBridge(sessionStore: store)
            let result = gatewayExecuteSessionTurn(
                bridge,
                gatewaySessionTurnGuardContext("telegram"),
                "status",
                deliver: true,
                streamingEnabled: true,
                deliverHook: Some({
                    _channelName: String,
                    _accountId: String,
                    _peerId: String,
                    text: String,
                    _replyToMessageId: Option<String>,
                    _replyInThread: Bool =>
                        sentTexts.add(text)
                        "m-${sentTexts.size}"
                })
            )

            @Expect(result.delivered, true)
            @Expect(sentTexts.size, 2)
            @Expect(sentTexts[0], "fun")
            @Expect(sentTexts[1].contains(finalText), true)
            for (text in sentTexts) {
                @Expect(text.contains("functions._answer_"), false)
            }
        } finally {
            setGatewayAgentBridgeReplyRunnerForTest(None<(String, String, String, String, Bool, Option<(String) -> Unit>) -> String>)
        }
    }

