package metis.gateway.core

import std.unittest.testmacro.*
import stdx.encoding.json.JsonValue

@Test
public class GatewayTelegramNativeCommandRuntimeTest {
    @TestCase
    public func parsesSlashCommandAliasesAndBotSuffixToCatalogCommand(): Unit {
        let runtime = GatewayTelegramNativeCommandRuntime()
        let decision = runtime.resolveText(
            "/tell@MetisBot worker stay focused",
            "8734062810",
            "default",
            "telegram:direct:8734062810",
            true
        )

        @Expect(decision.handled, true)
        let context = decision.context.getOrThrow()
        @Expect(context.command, "steer")
        @Expect(context.argsText, "worker stay focused")
        @Expect(context.commandText, "/steer worker stay focused")
        @Expect(decision.preflightReply, "")
    }

    @TestCase
    public func resolvesNativeCallbackDataThroughSameCatalogContext(): Unit {
        let runtime = GatewayTelegramNativeCommandRuntime()
        let decision = runtime.resolveCallbackData(
            "cmd:think:high",
            "8734062810",
            "default",
            "telegram:direct:8734062810",
            true
        )

        @Expect(decision.handled, true)
        let context = decision.context.getOrThrow()
        @Expect(context.isCallback, true)
        @Expect(context.command, "think")
        @Expect(context.commandText, "/think high")
        @Expect(decision.preflightReply, "")
    }

    @TestCase
    public func rejectsOperatorCommandsBeforeGatewayHandlerRuns(): Unit {
        let runtime = GatewayTelegramNativeCommandRuntime()
        let decision = runtime.resolveText(
            "/bash echo no",
            "123",
            "default",
            "telegram:direct:123",
            false
        )

        @Expect(decision.handled, true)
        let root = JsonValue.fromStr(decision.preflightReply).asObject()
        @Expect(root.get("action").getOrThrow().asString().getValue(), "bash")
        @Expect(root.get("status").getOrThrow().asString().getValue(), "rejected")
        @Expect(root.get("ok").getOrThrow().asBool().getValue(), false)
    }

    @TestCase
    public func catalogHasAllowedStatusesAndNoImplementedCommandWithoutHandler(): Unit {
        let validation = gatewayTelegramNativeCommandCatalogValidation()
        @Expect(validation.get("ok").getOrThrow().asBool().getValue(), true)
        @Expect(validation.get("invalidStatuses").getOrThrow().asArray().size(), 0)
        @Expect(validation.get("missingHandlers").getOrThrow().asArray().size(), 0)
        @Expect(gatewayFindTelegramNativeCommandSpec("allowlist").getOrThrow().status, "implemented")
        @Expect(gatewayFindTelegramNativeCommandSpec("codex_runtime").getOrThrow().command, "codex-runtime")
        @Expect(gatewayFindTelegramNativeCommandSpec("acp").getOrThrow().status, "not_applicable")
        @Expect(gatewayFindTelegramNativeCommandSpec("btw").getOrThrow().status, "not_applicable")
        @Expect(gatewayFindTelegramNativeCommandSpec("session").getOrThrow().argsMenuChoices.size, 0)
        @Expect(gatewayFindTelegramNativeCommandSpec("tools").getOrThrow().argsMenuChoices.size, 0)
        @Expect(gatewayFindTelegramNativeCommandSpec("activation").getOrThrow().argsMenuChoices.size, 0)
        @Expect(gatewayFindTelegramNativeCommandSpec("compact").getOrThrow().args.size, 0)
    }

    @TestCase
    public func metis3CkbRefreshCatalogIsOperatorOnlyAndAllowlistMenuOnly(): Unit {
        let spec = gatewayFindTelegramNativeCommandSpec("ckb_refresh").getOrThrow()
        @Expect(spec.command, "ckb-refresh")
        @Expect(spec.auth, "operator")
        @Expect(spec.aliases.contains("ckb_refresh"), true)
        @Expect(spec.args, ["target"])
        @Expect(spec.argsMenuChoices.contains("repo-catalog"), true)
        @Expect(spec.argsMenuChoices.contains("docs"), true)
        @Expect(spec.argsMenuChoices.contains("website-probe"), true)
        @Expect(spec.argsMenuChoices.contains("website-full"), true)
        @Expect(spec.argsMenuChoices.contains("web-candidates"), true)
        @Expect(spec.argsMenuChoices.contains("web-candidates-recrawl"), true)
        @Expect(spec.argsMenuChoices.contains("rebuild"), true)
        @Expect(spec.argsMenuChoices.contains("both"), true)
        @Expect(spec.argsMenuChoices.contains("status"), true)
        @Expect(spec.argsMenuChoices.contains("active-item"), false)
        @Expect(spec.argsMenuChoices.contains("active-repo"), false)
        @Expect(spec.argsMenuChoices.contains("repo-list"), false)
    }

    @TestCase
    public func codexRuntimeUnderscoreMenuCommandRoutesToGatewaySlashText(): Unit {
        let runtime = GatewayTelegramNativeCommandRuntime()
        let decision = runtime.resolveText(
            "/codex_runtime on",
            "8734062810",
            "default",
            "telegram:direct:8734062810",
            true
        )

        @Expect(decision.handled, true)
        @Expect(decision.preflightReply, "")
        let context = decision.context.getOrThrow()
        @Expect(context.command, "codex-runtime")
        @Expect(context.commandText, "/codex-runtime on")
        @Expect(context.argsText, "on")
    }
}
